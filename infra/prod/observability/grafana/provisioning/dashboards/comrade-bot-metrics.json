      "targets": [
        {
          "expr": "sum by (interaction_type, result) (increase(comrade_bot_interactions_total[15m]))",
          "legendFormat": "{{interaction_type}} {{result}}",
          "refId": "A"
        }
      ],
      "title": "Interactions per 15m by type/result",
