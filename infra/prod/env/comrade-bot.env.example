# Comrade-Bot Application Configuration
# Copy this to comrade-bot.env and fill in actual production values
# IMPORTANT: Change all CHANGE_ME values to strong, unique passwords/secrets

# Discord Bot Configuration
# DISCORD_BOT_TOKEN: Discord bot token from Discord Developer Portal
# Note: The script maps BOT_TOKEN to DISCORD_BOT_TOKEN, but you can use either
DISCORD_BOT_TOKEN=CHANGE_ME
# BOT_TOKEN=CHANGE_ME  # Alternative name (will be mapped to DISCORD_BOT_TOKEN)

# DISCORD_BOT_CLIENT_ID: Application/client ID from Discord Developer Portal.
# Required for command deployment and bot startup validation.
DISCORD_BOT_CLIENT_ID=CHANGE_ME

# GUILD_ID: Optional. Required only for local/guild command deployment.
# Leave unset for global command deployment.
# GUILD_ID=CHANGE_ME

# API Configuration
# API_URL: Politburo API endpoint (using service name in Docker network)
API_URL=http://politburo:8080

# API_KEY: Politburo API key used by runtime bot API calls.
API_KEY=CHANGE_ME

# Command deployment failure policy:
# default false = production deploy exits non-zero if command deploy fails.
# set true only for emergency bot restarts when commands will be deployed manually.
ALLOW_COMMAND_DEPLOY_FAILURE=false

# Observability
# Comrade Bot emits JSON logs to stdout/stderr and exposes Prometheus metrics
# internally for Prometheus scraping. Do not publish this port publicly.
APP_ENV=production
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9091
