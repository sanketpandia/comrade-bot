.PHONY: generate generate-bindings generate-politburo generate-infinite-flight generate-bot-client \
	openapi-bundle openapi-bundle-check check test build ci openapi-view openapi-stop \
	docs-site-deps docs-pack-api docs-build docs-serve

REPO_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/..)
CICD_DIR = $(REPO_ROOT)/cicd
GO_TOOL = cd $(CICD_DIR)/tools && go tool
REDOCLY = $(CICD_DIR)/node_modules/.bin/redocly
POLITBURO_DIR = $(REPO_ROOT)/services/politburo
BOT_DIR = $(REPO_ROOT)/services/comrade-bot-discord
OPENAPI_DIR = $(REPO_ROOT)/openapi
POLITBURO_SPEC_SRC = $(OPENAPI_DIR)/politburo/openapi.yaml
POLITBURO_SPEC = $(OPENAPI_DIR)/politburo.yaml
COMPOSE_DEV = $(REPO_ROOT)/infra/dev/docker-compose.dev.yml
DOCS_SITE = $(REPO_ROOT)/docs-site
DOCS_API_REF = $(DOCS_SITE)/docs/api/reference
REDOC_STANDALONE = $(DOCS_SITE)/node_modules/redoc/bundles/redoc.standalone.js

# Bundle first; bindings read the bundled spec (safe under make -j).
generate: openapi-bundle
	$(MAKE) -C $(CICD_DIR) generate-bindings

generate-bindings: generate-politburo generate-infinite-flight generate-bot-client

$(REDOCLY): $(CICD_DIR)/package.json $(CICD_DIR)/package-lock.json
	cd $(CICD_DIR) && npm ci --no-audit --no-fund
	touch $@

openapi-bundle: $(REDOCLY)
	$(REDOCLY) bundle $(POLITBURO_SPEC_SRC) -o $(OPENAPI_DIR)/.politburo.bundle.yaml
	{ echo "# GENERATED by 'make openapi-bundle' from openapi/politburo/. Do not edit."; cat $(OPENAPI_DIR)/.politburo.bundle.yaml; } > $(POLITBURO_SPEC)
	rm -f $(OPENAPI_DIR)/.politburo.bundle.yaml

openapi-bundle-check: openapi-bundle
	git -C $(REPO_ROOT) diff --exit-code -- openapi/politburo.yaml || \
		{ echo "openapi/politburo.yaml is stale: run 'make openapi-bundle' and commit it."; exit 1; }

generate-politburo:
	mkdir -p $(POLITBURO_DIR)/internal/api/generated/politburo
	$(GO_TOOL) oapi-codegen -config $(CICD_DIR)/codegen/politburo-oapi-codegen.yaml $(POLITBURO_SPEC)

generate-infinite-flight:
	mkdir -p $(POLITBURO_DIR)/internal/api/generated/infiniteflight
	$(GO_TOOL) oapi-codegen -config $(CICD_DIR)/codegen/infinite-flight-oapi-codegen.yaml $(OPENAPI_DIR)/infinite-flight/openapi.yaml

generate-bot-client:
	cd $(BOT_DIR) && npm run api:generate

check: generate
	cd $(POLITBURO_DIR) && go test ./...

test:
	cd $(POLITBURO_DIR) && go test ./...
	cd $(BOT_DIR) && npm test

build:
	cd $(POLITBURO_DIR) && go build -buildvcs=false ./cmd/politburo
	cd $(BOT_DIR) && npm run build

ci: generate test build

openapi-view: openapi-bundle
	$(MAKE) -C $(CICD_DIR) generate-politburo generate-infinite-flight
	docker compose -f $(COMPOSE_DEV) up -d swagger-editor
	@echo "Politburo API: http://localhost:8081"

openapi-stop:
	docker compose -f $(COMPOSE_DEV) stop swagger-editor

$(REDOC_STANDALONE): $(DOCS_SITE)/package.json $(DOCS_SITE)/package-lock.json
	cd $(DOCS_SITE) && npm ci --no-audit --no-fund

docs-site-deps: $(REDOC_STANDALONE)

docs-pack-api: openapi-bundle docs-site-deps
	mkdir -p $(DOCS_API_REF)
	cp $(DOCS_SITE)/api-renderer/index.html $(DOCS_API_REF)/
	cp $(REDOC_STANDALONE) $(DOCS_API_REF)/redoc.standalone.js
	cp $(POLITBURO_SPEC) $(DOCS_API_REF)/openapi.yaml

docs-build: docs-pack-api
	python3 -m pip install -q -r $(DOCS_SITE)/requirements.txt
	cd $(DOCS_SITE) && python3 -m mkdocs build -d site

docs-serve: docs-pack-api
	cd $(DOCS_SITE) && python3 -m mkdocs serve
