JOBS_ENABLED=

PG_DB=
PG_HOST=

IF_API_KEY=

# Infinite Flight OAuth (dashboard connect). Callback is {UI_BASE_URL}/oauth/callback.
INFINITE_FLIGHT_CLIENT_ID=
INFINITE_FLIGHT_CLIENT_SECRET=

# 32-byte raw value or 64-character hex. Local defaults to a documented
# development key when unset; required outside APP_ENV=local.
SIGNED_LINK_SECRET=
# Optional at-rest root. Standard base64 of 32 bytes from `openssl rand -base64 32`.
# Leave empty to disable data connections. Use DATA_ENCRYPTION_KEY_FILE instead of putting both.
DATA_ENCRYPTION_KEY=

# Absolute UI origin used in signed-link URLs. Defaults to http://localhost:8082.
UI_BASE_URL=

# Comma-separated Discord user ids allowed on operator routes and /operator/reports.
PLATFORM_OPERATOR_DISCORD_IDS=